<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:layout_marginTop="10dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/view_logo"
            android:layout_width="52dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_default_avatar"
            android:scaleType="centerCrop"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_top_title"
            android:textColor="#13141a"
            android:textSize="18sp"
            android:layout_marginStart="6dp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/view_logo"
            app:layout_constraintBottom_toBottomOf="@id/view_logo"
            app:layout_constraintStart_toEndOf="@id/view_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:textSize="12sp"
            android:textColor="#666666"
            android:text="@string/main_top_url"
            android:layout_marginEnd="16dp"
            android:background="@drawable/shape_round_66dbdeec"
            app:layout_constraintTop_toTopOf="@id/view_logo"
            app:layout_constraintBottom_toBottomOf="@id/view_logo"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="11dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="@color/black"
            android:text="请先选择游戏包目录，然后再启动游戏，也可在下方输入框直接输入目录路径" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_manifest_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:text="如果manifest.json不在游戏包目录下，则自定义选择" />

        </HorizontalScrollView>

        <EditText
            android:id="@+id/et_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="可以直接输入目录路径"
            android:textColorHint="#aaaaaa"
            android:textSize="17sp"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/btn_select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:text="选择游戏包目录"
            android:textSize="17sp"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_select_manifestjson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:text="选择manifest.json"
            android:textSize="17sp"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:text="启动游戏"
            android:textSize="17sp"
            android:textColor="@color/white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>